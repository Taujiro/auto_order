# Optional local configuration.
# This file is only a reference; the app reads environment variables from the shell.

# Folder containing supplier price reference workbooks.
# Expected files in the current version: Autobras.xlsx, Tuba.xlsx, Tsa.xlsx
PRICE_REFERENCE_DIR=C:\path\to\price_references

# Optional real PDFs used only when running parser tests locally.
AUTOBRAS_QUOTE_PDF=C:\path\to\autobras_quote.pdf
TUBA_QUOTE_PDF=C:\path\to\tuba_quote.pdf
TSA_QUOTE_PDF=C:\path\to\tsa_quote.pdf
GONEL_QUOTE_PDF=C:\path\to\gonel_quote.pdf
WISA_QUOTE_PDF=C:\path\to\wisa_quote.pdf
